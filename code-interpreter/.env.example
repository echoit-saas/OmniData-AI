# File Server Configuration
FILE_SERVER_PORT=3000

# MinIO Configuration
MINIO_BUCKET=minio_bucket_name
MINIO_ENDPOINT=minio_endpoint
MINIO_USE_SSL=TRUE
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_NO_PORT=TRUE

# Redis Configuration
REDIS_HOST=redis_host
REDIS_PASSWORD=redis_password

# Sandbox Configuration
# macOS local dev: use COMPOSE_FILE=docker-compose.yaml:docker-compose.mac.yml
KVM_ENABLED=true
KVM_DEVICE_PATH=/dev/kvm
SANDBOX_USE_CGROUPV2=true
SANDBOX_LOG_LEVEL=DEBUG
SANDBOX_MAX_PROCESS_COUNT=100
SANDBOX_RUN_CPU_TIME=10000
SANDBOX_RUN_TIMEOUT=15000
SANDBOX_OUTPUT_MAX_SIZE=65536

# Docker Compose keeps hardened mode enabled. Its API exposes bridge routes even
# with the default HTTP sandbox backend, so configure a private enrollment token
# of at least 32 bytes before starting Compose (generate with: openssl rand -hex 32).
# Do not use a shared example token. These defaults accept paired dynamic workers;
# enrollment still requires the token. Never provide this token to sandbox code.
CODEAPI_BRIDGE_TOKEN=
CODEAPI_BRIDGE_AUTH_MODE=paired
CODEAPI_BRIDGE_DYNAMIC_WORKERS=true
# For a fixed worker, set DYNAMIC_WORKERS=false and WORKER_ID to that worker's ID.
CODEAPI_BRIDGE_WORKER_ID=

# Remote stateful code bridge (Code API deployment)
# CODEAPI_SANDBOX_BACKEND=remote-bridge
# CODEAPI_EXECUTION_PROFILE=stateful
# CODEAPI_RUNTIME_SESSION_MODE=affinity

# Service Configuration
PYTHON_CONCURRENCY=5
OTHER_CONCURRENCY=15
JOB_WINDOW=1000

# Database Configuration
MONGODB_URI=mongo_uri


# Logging
LOGGING_SERVER_IP=host.docker.internal

# -----------------------------------------------------------------------------
# Stripe: https://shipfa.st/docs/features/payments
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Mailgun: https://shipfa.st/docs/features/emails
# -----------------------------------------------------------------------------
# EMAIL_SERVER=smtp://postmaster@[mail.yourdomain.com]:[copied_password]@smtp.mailgun.org:587 (without the brackets)
EMAIL_SERVER=

# Newsletter
NEWSLETTER_SECRET=somesecretvalue

# api.librechat.ai
LOGGING_ENABLED=true

SANDBOX_ACCESS_TOKEN=







# Added by Akashx team for LibreChat code interpreter
# ----------- start ------------------
LOCAL_MODE=false
CODEAPI_AUTH_PROVIDER=librechat-jwt
CODEAPI_JWT_ISSUER=librechat
CODEAPI_JWT_AUDIENCE=codeapi
CODEAPI_JWT_ALLOWED_ALGS=EdDSA
CODEAPI_JWT_CLOCK_SKEW_SECONDS=30
CODEAPI_JWT_MAX_TTL_SECONDS=300
CODEAPI_JWT_KEY_CACHE_TTL_SECONDS=30
CODEAPI_JWT_JWKS_JSON={"keys":[{"crv":"Ed25519","x":"n6rqC_OrqZ-yb5QoLBqllG49oUKXhcikISp9c0glD2U","kty":"OKP","kid":"lc-codeapi-local-2026-05","alg":"EdDSA"}]}
CODEAPI_JWT_SINGLE_TENANT_ID=legacy
CODEAPI_BRIDGE_TOKEN=
CODEAPI_EXECUTION_MANIFEST_PRIVATE_KEY=
SANDBOX_EXECUTION_MANIFEST_PUBLIC_KEY=
KVM_ENABLED=false
# ----------- end ------------------
